# BlindVote API environment
#
# Copy to echo-server/.env for local development. Never commit real values.
# Generate strong secrets with: openssl rand -base64 32

PORT=3001
NODE_ENV=development

# PostgreSQL. Local example:
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/echo_voting"
# Set to true when the provider requires TLS (Render external URL, Supabase).
# DATABASE_SSL=false

# Required in every environment.
JWT_SECRET="change-me"
VOTE_ENCRYPTION_KEY="change-me"
DEVICE_BINDING_PEPPER="change-me"
REGISTRATION_CODE_PEPPER="change-me"

# Web client origin used by CORS and password-reset links.
FRONTEND_URL="http://localhost:3000"
# Extra comma-separated origins, e.g. a preview deployment.
CORS_ORIGINS=""

# Email (optional).
EMAIL_DOMAIN="echo-platform.local"
RESEND_API_KEY=""
FROM_EMAIL="onboarding@resend.dev"

# Supabase storage for profile images (optional).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Passkeys (optional).
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"
WEBAUTHN_RP_NAME="BlindVote"

# Governance and on-chain ledger (optional).
GOVERNANCE_THRESHOLD=2
# Calculate and store results automatically when an election's end date passes.
# Set to false when results must be published through multi-sig governance.
AUTO_PUBLISH_RESULTS=true
# How often the server checks for elections that should open/close (ms).
# Set to 0 to disable the background scheduler.
ELECTION_STATUS_INTERVAL_MS=60000
CHAIN_ENABLED=false
CHAIN_ID=""
CHAIN_RPC_URL=""
CHAIN_PRIVATE_KEY=""
CHAIN_LEDGER_ADDRESS=""

# Admin data console (optional). Resetting data is allowed automatically in
# non-production environments; set this to true to allow it in production.
ALLOW_ADMIN_RESET=false

# Close elections and auto-publish results even with no incoming traffic.
# ELECTION_TICKER=false disables it; ELECTION_TICK_MS controls the interval.
ELECTION_TICKER=true
ELECTION_TICK_MS=60000

# Backfill anonymous commitments to the optional on-chain ledger in the
# background. CHAIN_SYNC_TICKER=false disables it.
CHAIN_SYNC_TICKER=true
CHAIN_SYNC_INTERVAL_MS=120000

# Native Android in-app updater (optional).
APP_VERSION_CODE=""
APP_VERSION_NAME=""
APP_APK_URL=""
APP_RELEASE_NOTES=""
